#!/usr/bin/env bash

set -e

run_image() {
    local repo_name=${1:-"node2.bdcl:5000"}
    local image_name="${repo_name}/graphrag:latest"

    docker pull ${image_name}

    docker run -d --name graphrag \
        -v $(pwd)/graphrag_data:/data \
        ${image_name} \
        index --root /data
}

build_image() {
    echo "Building image..."
    # Export requirements.txt using poetry
    poetry export -f requirements.txt --output requirements.txt --without-hashes
    
    # Build wheel using poetry
    poetry build
    
    # Build the docker image
    docker build -t graphrag:latest -f ./docker/Dockerfile .
    
    echo "Image built successfully: graphrag:latest"
}

push_image() {
    local repo_name=${1:-"node2.bdcl:5000"}
    
    echo "Pushing image to registry..."
    # Tag the docker image
    docker tag graphrag:latest ${repo_name}/graphrag:latest
    
    # Push the docker image to the registry
    docker push ${repo_name}/graphrag:latest
    
    echo "Image pushed successfully: ${repo_name}/graphrag:latest"
}

deploy_image() {
    local repo_name=${1:-"myrepo"}
    
    # Do both build and push
    build_image
    push_image "$repo_name"
    
    echo "Deployment complete!"
}

display_help() {
    echo "Usage: grctl COMMAND [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  build-image         Build the Docker image"
    echo "  push-image [REPO]   Push the image to registry (default repo: myrepo)"
    echo "  deploy-image [REPO] Build and push the image (default repo: myrepo)"
    echo "  run-image [REPO]    Run the image using pushed image (default repo: node2.bdcl:5000)"
    echo "  help                Display this help message"
}

main() {
    local command=$1
    shift || true
    
    case "$command" in
        build-image)
            build_image "$@"
            ;;
        push-image)
            push_image "$@"
            ;;
        deploy-image)
            deploy_image "$@"
            ;;
        run-image)
            run_image "$@"
            ;;
        help|--help|-h)
            display_help
            ;;
        *)
            echo "Error: Unknown command '$command'"
            display_help
            exit 1
            ;;
    esac
}

# Execute main function with all arguments
main "$@"
